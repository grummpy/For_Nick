{
  "name": "for-nick",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "main": "electron-main.js",
  "author": "grummpy",
  "scripts": {
    "dev": "node server.js",
    "start": "electron .",
    "package:mac": "electron-builder --mac dmg zip --arm64 && electron-builder --mac dmg zip --x64",
    "package:win": "electron-builder --win nsis portable --x64",
    "package:all": "npm run package:mac && npm run package:win"
  },
  "description": "Purrplexity: a calm, file-aware OpenAI query workspace with a responsive cat companion.",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.grummpy.purrplexity",
    "productName": "Purrplexity",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!.env",
      "!launch-for-nick.command"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Purrplexity Installer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Purrplexity"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
